<?xml version="1.0" encoding="utf-8"?>
<!-- Test APK only. No recording entry or permission opt-in is added to the public APK. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <queries><package android:name="com.openkhub.sensefield" /></queries>
    <application android:allowAudioPlaybackCapture="true">
        <activity android:name="com.openkhub.sensefield.NativeDemoProbeActivity"
            android:label="听野录制验证（测试）" android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name="com.openkhub.sensefield.NativeDemoProbeService"
            android:exported="false" android:foregroundServiceType="mediaProjection|microphone" />
    </application>
</manifest>

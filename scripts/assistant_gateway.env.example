# Copy to a root-readable environment file on the gateway host and set real
# values there. Never add actual device tokens or API keys to the repository.
ASSISTANT_GATEWAY_DEVICE_TOKEN=replace-with-a-long-random-device-token
ASSISTANT_GATEWAY_MODEL_CACHE=/var/lib/mapassist/models
ASSISTANT_GATEWAY_ACCOUNT_CONCURRENCY=1
ASSISTANT_GATEWAY_PORT=8765
ASSISTANT_GATEWAY_TLS_CERT=/etc/mapassist/tls/fullchain.pem
ASSISTANT_GATEWAY_TLS_KEY=/etc/mapassist/tls/private.key
# Optional. Only /v1/visual needs this key; authenticated ASR-only mode starts without it.
# ZHIPU_API_KEY=replace-with-the-server-side-zhipu-api-key
